# Android emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# For a physical device, use the development computer's LAN IP instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Production must use the stable HTTPS deployment:
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.example

# Required by Android development/store builds for the embedded Google map.
# Enable Maps SDK for Android, then restrict this key to package
# com.voucherhunt.mobile and the applicable signing-certificate SHA-1.
# GOOGLE_MAPS_API_KEY=your_restricted_android_maps_key

# AdMob application id, read at build time and baked into the native manifest.
# The Google Mobile Ads SDK crashes at launch if this is missing or malformed;
# app.config.js falls back to Google's published test id so a build without it
# still runs. Note the "~".
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000

# Rewarded ad unit, read at runtime. Note the "/". Leave unset to use Google's
# test unit, which always fills but carries no server-side verification, so the
# ad plays and the mission is never credited.
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ANDROID=ca-app-pub-0000000000000000/0000000000
