NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser key used by the dashboard's interactive business-location picker.
# Enable Maps JavaScript API + Geocoding API and restrict it to the dashboard's
# localhost and production HTTP referrers.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Database (PostgreSQL). Required in every environment; there is no local file
# mode. Use the pooled connection string: serverless functions open and drop
# connections constantly, and the direct endpoint runs out under real traffic.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Tests get a database of their own and will not fall back to DATABASE_URL.
# resetDb() empties every table, so a misconfigured run pointed at production
# would not fail, it would succeed.
TEST_DATABASE_URL=

# SMS provider: mock|smpp|movider|twilio|infobip|clicksend
# mock logs "[SMS MOCK] To: ..." to the console and always succeeds; use it
# for local dev. Leave unset to default to mock.
SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=VoucherHunt

# --- SMPP worker (the hosted path) -------------------------------------------
# The SMSC whitelists ONE client IP and allows ONE concurrent bind, so binding
# directly from Vercel never works: every invocation egresses from a different
# shared address and the bind times out with no response. Run
# `npm run start:smpp-worker` on a host holding the whitelisted IP and point the
# app at it. Use SMS_PROVIDER=smpp_worker in every hosted environment; plain
# `smpp` only works from a machine whose IP is the whitelisted one (local dev).
# SMS_PROVIDER=smpp_worker
# SMPP_WORKER_URL=https://replace-with-worker-host
# SMPP_WORKER_API_TOKEN=replace-with-random-value      # app -> worker
# SMPP_WORKER_CALLBACK_SECRET=replace-with-random-value # worker -> app (DLRs)
# SMPP_DLR_CALLBACK_URL=https://replace-with-app-url/api/sms/delivery-receipt
# SMPP_WORKER_PORT=8080                                 # worker only
# SMPP_WORKER_TIMEOUT_MS=20000                          # app-side cap

# SMPP (direct SMSC / local Philippine SMS aggregator). Used when SMS_PROVIDER=smpp.
# Only binds successfully from the provider-whitelisted IP. The worker above
# needs these same credentials.
# SMS_PROVIDER=smpp
# SMPP_HOST=smsc.example.com
# SMPP_PORT=2775
# SMPP_SYSTEM_ID=your_smpp_system_id
# SMPP_PASSWORD=your_smpp_password
# SMPP_BIND_TYPE=transceiver          # transceiver | transmitter
# Registered sender IDs. A per-carrier match is used when set; otherwise the default.
# SMPP_SOURCE_ADDR=VoucherHunt            # default sender (falls back to SMS_SENDER_ID)
# SMPP_SOURCE_ADDR_SMART=your_smart_sender_id
# SMPP_SOURCE_ADDR_GLOBE=your_globe_sender_id
# Address TON/NPI. Defaults suit alphanumeric sender + international MSISDN.
# SMPP_SOURCE_ADDR_TON=5
# SMPP_SOURCE_ADDR_NPI=0
# SMPP_DEST_ADDR_TON=1
# SMPP_DEST_ADDR_NPI=1
# SMPP_REGISTERED_DELIVERY=1          # 1 = request delivery receipts (DLR)
# Optional tuning (milliseconds) and diagnostics. The defaults are sized to fit
# inside the SMS routes' `maxDuration = 30` on serverless: a cold instance pays
# the SMPP bind inside the request, and anything longer than the function budget
# is killed mid-send and surfaces as an opaque 504 rather than an SMPP error.
# Raise these only alongside maxDuration in the routes.
# SMPP_BIND_TIMEOUT_MS=12000          # covers connect + bind
# SMPP_CONNECT_TIMEOUT_MS=12000
# SMPP_SUBMIT_TIMEOUT_MS=8000         # per message part
# SMPP_ENQUIRE_LINK_MS=10000
# SMPP_DEBUG=false

# How long the "Confirm & Reserve" response waits on the SMS provider before
# returning anyway. The voucher is already committed at that point, so this only
# caps how long the visitor waits on delivery; a slow send continues in the
# background and is logged in sms_logs either way.
# SMS_RESPONSE_BUDGET_MS=4000

# Movider (Philippines) -- https://developer.movider.co
# SMS_PROVIDER=movider
# SMS_API_KEY=your_movider_api_key
# SMS_API_SECRET=your_movider_api_secret
# SMS_SENDER_ID=VoucherHunt

# Twilio
# SMS_PROVIDER=twilio
# SMS_API_KEY=your_twilio_account_sid
# SMS_API_SECRET=your_twilio_auth_token
# SMS_SENDER_ID=+1234567890

# Infobip
# SMS_PROVIDER=infobip
# SMS_API_KEY=your_infobip_api_key
# INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
# SMS_SENDER_ID=VoucherHunt

# ClickSend
# SMS_PROVIDER=clicksend
# SMS_API_KEY=your_clicksend_username
# SMS_API_SECRET=your_clicksend_api_key
# SMS_SENDER_ID=VoucherHunt

# Dashboard login — the BOOTSTRAP account only. Real accounts are created in the
# console at /dashboard/team and stored in the admin_users table; an email that
# matches a managed account is authenticated against that account, and these
# values are never consulted for it. Keep this pair so there is always a way in
# when no accounts exist yet, then create a super admin and stop using it.
#
# Replace every example value before deployment. With no .env at all,
# `next dev` falls back to admin@bizflow.local / admin-password and
# staff@bizflow.local / staff-password, and the login page shows one-click fill
# buttons for both. Production has no fallback: it requires ADMIN_EMAIL and
# ADMIN_PASSWORD or the login route returns E-ADMIN-CONFIG.
ADMIN_NAME=Voucher Hunt Admin
ADMIN_EMAIL=admin@bizflow.local
ADMIN_PASSWORD=change-this-admin-password
# Generate a long random value (at least 32 characters). Changing it logs out
# every active admin session.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Signs the short-lived custom_data an AdMob rewarded ad carries, which is the
# only link between a signed-in customer and the server-side verification
# callback Google later sends. Falls back to ADMIN_SESSION_SECRET when unset,
# so ad missions work out of the box in development; give production a value of
# its own so rotating one secret does not invalidate the other.
ADMOB_SSV_NONCE_SECRET=replace-with-at-least-32-random-characters

# --- AdMob, app side ------------------------------------------------------
# All four are optional. Left unset, the app falls back to Google's published
# test ids: it builds, runs, and plays a test ad end to end. What it cannot do
# on test inventory is pay anybody, because a test ad unit has no server-side
# verification callback to point at this backend. Real ids are what turn the
# three daily ad missions from visible into completable.
#
# Application ids (note the "~"). Read at BUILD time by app.config.js and baked
# into the native manifest, so changing them needs a rebuild, not a restart.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000
#
# Rewarded ad unit ids (note the "/"). Read at RUNTIME. The SSV callback URL is
# configured per ad unit in the AdMob console; see docs/ADMOB_SETUP.md.
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ANDROID=ca-app-pub-0000000000000000/0000000000
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_IOS=ca-app-pub-0000000000000000/0000000000

# Optional server-only bearer token for trusted scripts/integrations.
# Never expose this value through a NEXT_PUBLIC_ variable.
ADMIN_ACCESS_TOKEN=local-admin-integration-token
# Destructive demo-data reset stays disabled unless dev tooling is recognised
# (see ENABLE_DEV_TOOLS below) or this is explicitly set.
ALLOW_DASHBOARD_RESET=false

# --- Dev tooling gate -------------------------------------------------------
# Controls every tool that mints value or bypasses a rule: LP grants, simulated
# checkout scans, forced roulette outcomes, hunt resets, statement backdating, the
# bootstrap login fallback below, and echoing the OTP back in the API response.
#
# Enabled automatically when NODE_ENV is `development` or `test`. Set this to
# `true` to enable it on a shared demo box whose NODE_ENV is something else.
# Ignored when NODE_ENV=production — that combination stays disabled.
# Anything unrecognised (unset, `preview`, `staging`) is disabled, which is the
# point: these must not open just because a deploy forgot to set NODE_ENV.
# ENABLE_DEV_TOOLS=false

# --- Rate limiting ----------------------------------------------------------
# How many proxies sit between the internet and this app. Limits key on the
# address the outermost trusted hop reported; everything to its left in
# X-Forwarded-For was supplied by the caller and cannot be believed. 1 is right
# for Vercel and for a single nginx/Cloudflare in front of the app. Raise it only
# if you genuinely run more hops — set too high, callers can pick their own
# rate-limit bucket again and every limit in the app becomes decorative.
# TRUSTED_PROXY_HOPS=1

# Optional business-scoped staff login (exactly one business ID per account).
# Also bootstrap-only — prefer creating staff accounts at /dashboard/team.
STAFF_NAME=Campaign Staff
STAFF_EMAIL=staff@bizflow.local
STAFF_PASSWORD=change-this-staff-password
STAFF_BUSINESS_IDS=biz_demo_restaurant

# Optional salt for hashing OTP codes at rest (defaults to ADMIN_ACCESS_TOKEN).
# OTP_SALT=replace-with-random-value
# Optional salt for hashing IPs in the rate-limit table (defaults to ADMIN_ACCESS_TOKEN).
# RATE_LIMIT_SALT=replace-with-random-value

# --- Google Play review account ---------------------------------------------
# Lets one number sign in with a fixed code instead of an SMS, because Play's
# reviewers cannot receive the OTP. Both must be set or the bypass stays inert;
# the code must be exactly 6 digits. Use a RANDOM code, not 000000 — it is
# long-lived, and only the per-IP rate limit stands between it and a guesser.
# Must match what is entered under Play Console > App content > App access.
# UNSET BOTH once the app is live. See docs/PLAY_CONSOLE_ANSWERS.md §2.
# REVIEW_ACCOUNT_PHONE=09171234567
# REVIEW_ACCOUNT_OTP=replace-with-random-6-digits

# --- Production developer accounts -------------------------------------------
# Customer numbers that keep the self-scoped dev tools in production, where
# ENABLE_DEV_TOOLS above can never open: reset my hunt, refresh my vouchers,
# force my own next roulette draw, and top up my own LP — both the global pot
# and one partner's bucket. All of them touch only rows keyed to this number.
#
# The LP grants mint spendable points, so treat the number as privileged, but
# they bill nobody: the ledger records a dev_grant against this wallet and no
# partner statement moves.
#
# NOT granted: simulated checkout scans and simulated collection. Those write
# rows a real partner is invoiced for and stay refused in production for every
# account, this one included. No dashboard or admin rights either — this is an
# ordinary customer account with the dev tools switched on.
#
# Also what makes the mobile More tab show its dev panel, on every backend —
# local development included. ENABLE_DEV_TOOLS above still decides what the
# tools may do, but it no longer decides who sees them, because it opened the
# panel for every ordinary test account signed in against a dev deployment. Set
# a slot below to your own number if you want the panel while working locally.
#
# Read per request, so unsetting it revokes the tools without a redeploy.
# DEV_ACCOUNT_PHONE=09171234567
#
# Optional, and independent of the line above. Set it only if the number is NOT
# a handset you hold — it is a password that never expires or rotates, whereas
# leaving it unset means signing in by real SMS like any other customer. Exactly
# 6 digits, and RANDOM: not a birthday, not a date. The per-number limiter on
# the verify route (10 tries / 15 min) is all that stands between it and a
# guesser working through 10^6.
# DEV_ACCOUNT_OTP=replace-with-random-6-digits
#
# Second slot, for a second developer. Identical rules and identical rights to
# the pair above, and independent of it — either may be set without the other.
# A third would be DEV_ACCOUNT_PHONE_3 / DEV_ACCOUNT_OTP_3, which also needs an
# entry in DEV_ACCOUNT_ENV_PAIRS in src/server/dev-tools.ts.
# DEV_ACCOUNT_PHONE_2=09171234568
# DEV_ACCOUNT_OTP_2=replace-with-random-6-digits

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for every /api/cron/* route: the notification fan-out and the
# nightly maintenance job (retention sweep + Loyalty Points reconciliation).
# The routes refuse to run when this is unset, so an unconfigured deploy cannot
# be triggered publicly. Send it as `Authorization: Bearer <secret>` or
# `?secret=<secret>` — Vercel Cron sends the bearer form by itself, for the
# schedules declared in vercel.json.
# CRON_SECRET=replace-with-random-value

# --- Alerting ---------------------------------------------------------------
# Optional, and the only thing that turns a 500 into something a human hears
# about. Any Slack or Discord incoming webhook URL works as-is. Failures are
# always written to stdout as JSON whether or not this is set; this is the half
# that interrupts someone. See src/server/monitoring.ts.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Push notifications -----------------------------------------------------
# Optional. Only needed if the Expo project enforces push security; unset works
# for the default setup, where Expo relays to FCM on our behalf.
# EXPO_ACCESS_TOKEN=
# Optional. How long to wait on Expo's push endpoint before logging a failure.
# PUSH_TIMEOUT_MS=8000

# --- Android App Links ------------------------------------------------------
# Served at /.well-known/assetlinks.json so Android verifies deep links and
# opens them in the app instead of showing a chooser.
# Use the *Play App Signing* SHA-256, not the upload key: Play re-signs the AAB.
# Play Console -> Release -> Setup -> App signing -> App signing key certificate.
# Comma-separate to also verify a local debug build.
# ANDROID_PACKAGE_NAME=com.voucherhunt.mobile
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
