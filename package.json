{
  "name": "bizflow-voucher-hunter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "mobile": "npm run start --workspace @voucher-hunt/mobile",
    "mobile:android": "npm run android --workspace @voucher-hunt/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @voucher-hunt/mobile",
    "sms:logs": "node --env-file=.env scripts/sms-logs.mjs",
    "start:smpp-worker": "node server/smpp-worker.cjs",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worker.local server/smpp-worker.cjs"
  },
  "dependencies": {
    "@bizflow/shared": "*",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.0",
    "leaflet": "^1.9.4",
    "next": "14.2.30",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "smpp": "^0.6.0-rc.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.53.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/google.maps": "^3.65.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "20.19.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.30",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
