# Environment for the SMPP worker, read by systemd.
#
#   install -o root -g root -m 600 smpp-worker.env.example /etc/smpp-worker.env
#   sudoedit /etc/smpp-worker.env
#
# systemd's EnvironmentFile is NOT a shell script: no `export`, no command
# substitution, no variable expansion. Plain KEY=value only. Double quotes are
# understood and stripped, which is why the sender ID containing a space is
# quoted below.
#
# Values here duplicate the SMPP block of the app's .env by design — the worker
# runs on a different host and never reads that file.

# --- App -> worker -----------------------------------------------------------
# Bearer token the app must present on POST /messages. Must match the app's
# SMPP_WORKER_API_TOKEN exactly.
SMPP_WORKER_API_TOKEN=replace_with_app_to_worker_token
SMPP_WORKER_PORT=8080

# --- Worker -> app (delivery receipts) ---------------------------------------
# Where DLRs are forwarded, and the token presented when forwarding them. Must
# match the app's SMPP_WORKER_CALLBACK_SECRET. Point the URL at the PRODUCTION
# app: this host cannot reach a localhost dev server.
SMPP_DLR_CALLBACK_URL=https://replace-with-app-domain/api/sms/delivery-receipt
SMPP_WORKER_CALLBACK_SECRET=replace_with_worker_to_app_secret

# --- SMSC --------------------------------------------------------------------
# The worker refuses to start while any required value still carries the
# replace_with_ prefix, so a half-filled file fails loudly at boot.
SMPP_HOST=replace_with_smsc_host
SMPP_PORT=2775
SMPP_SYSTEM_ID=replace_with_system_id
SMPP_PASSWORD=replace_with_password
SMPP_BIND_TYPE=transceiver
SMPP_REGISTERED_DELIVERY=1

# Registered sender IDs. Per-carrier when set, otherwise SMPP_SOURCE_ADDR.
# An unregistered sender is rejected with ESME_RINVSRCADR.
SMPP_SOURCE_ADDR="replace_with_default_sender"
SMPP_SOURCE_ADDR_SMART="replace_with_smart_sender"
SMPP_SOURCE_ADDR_GLOBE=replace_with_globe_sender

# Address TON/NPI: alphanumeric sender + international MSISDN.
SMPP_SOURCE_ADDR_TON=5
SMPP_SOURCE_ADDR_NPI=0
SMPP_DEST_ADDR_TON=1
SMPP_DEST_ADDR_NPI=1

# Timeouts. Generous on purpose — this process holds a long-lived session and is
# not racing a serverless function budget.
SMPP_BIND_TIMEOUT_MS=30000
SMPP_CONNECT_TIMEOUT_MS=30000
SMPP_SUBMIT_TIMEOUT_MS=30000
SMPP_ENQUIRE_LINK_MS=10000
SMPP_DEBUG=false
